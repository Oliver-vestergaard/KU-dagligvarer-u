---
import "../style/global.css";
import "../style/style.css";
import Nav from "../components/Nav.astro";
import Card from "../components/Forsidecard.astro";
import Devider from "../components/Devider.astro";
import { products } from "../data/products.js";

const categories = ["Fruits & Vegetables", "Bakery", "Canned & Dry Goods", "Meat", "Dairy", "Beverages", "Snacks"];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />

    <title>Forside</title>

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/logo/Logo_interrim.webp" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Arimo:ital,wght@0,400..700;1,400..700&family=Karla:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet" />
  </head>

  <body>
    <header></header>

    <main>
      <Nav />

      <div class="Info">
        <section class="form-section">
          <h2>Before you start</h2>

          <label for="age">How old are you?</label>
          <input type="number" id="age" min="1" max="120" />

          <fieldset>
            <legend>How would you define your sex?</legend>

            <label>
              <input type="radio" name="sex" value="Male" />
              Male
            </label>

            <label>
              <input type="radio" name="sex" value="Female" />
              Female
            </label>

            <label>
              <input type="radio" name="sex" value="Non-binary" />
              Non-binary
            </label>

            <label>
              <input type="radio" name="sex" value="Other" />
              Other
            </label>
          </fieldset>

          <fieldset>
            <legend>Do you live alone, with roommates or at home?</legend>

            <label>
              <input type="radio" name="living" value="Alone" />
              Alone
            </label>

            <label>
              <input type="radio" name="living" value="Roommates" />
              With roommates
            </label>

            <label>
              <input type="radio" name="living" value="At home" />
              At home
            </label>
          </fieldset>

          <label for="restrictions"> Do you have any food restrictions? </label>

          <input type="text" id="restrictions" placeholder="Allergies, vegetarian, vegan etc." />
        </section>
      </div>

      {
        categories.map((category) => (
          <section class="category">
            <h3 class="KategoriHeadline">{category}</h3>

            <Devider />

            <div class="KategoriGrid">
              {products
                .filter((product) => product.category === category)
                .map((product) => (
                  <Card product={product} />
                ))}
            </div>
          </section>
        ))
      }
    </main>

    <footer></footer>
  </body>
</html>

<style>
  .form-section {
    max-width: 800px;
    margin: 3rem 4rem 5rem;
  }

  .form-section h2 {
    margin-bottom: 2rem;
  }

  .form-section {
    display: grid;
    gap: 1rem;
  }

  .form-section label,
  .form-section legend {
    font-family: "Karla", sans-serif;
    font-size: 1.1rem;
    font-weight: bold;
    color: var(--text-color);
  }

  .form-section input[type="number"],
  .form-section input[type="text"] {
    width: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--text-color);
    background-color: transparent;
    font-family: "Karla", sans-serif;
    font-size: 1rem;
    color: var(--text-color);
    margin-bottom: 1rem;
  }

  .form-section input:focus {
    outline: 2px solid var(--text-color);
    outline-offset: 2px;
  }

  .form-section fieldset {
    border: none;
    padding: 0;
    margin: 1rem 0;
    display: grid;
    gap: 0.75rem;
  }

  .form-section legend {
    margin-bottom: 0.75rem;
  }

  .form-section fieldset label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: normal;
  }

  .form-section input[type="radio"] {
    width: 18px;
    height: 18px;
    accent-color: var(--text-color);
  }

  .form-section input::placeholder {
    color: var(--text-color);
    opacity: 0.6;
  }

  @media (max-width: 800px) {
    .form-section {
      margin: 2rem 1rem 4rem;
    }
  }
</style>
